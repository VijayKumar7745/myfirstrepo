## 4. Database operations – EmployeeDAO.java

This class retrieves, searches, inserts, updates and deletes employee records.

```

package com.ems;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

public class EmployeeDAO {

    public List<Employee> getAllEmployees(String search)
            throws Exception {

        List<Employee> list = new ArrayList<Employee>();

        Connection con = null;
        PreparedStatement ps = null;
        ResultSet rs = null;

        try {
            con = DBConnection.getConnection();

            String sql =
                "SELECT * FROM INFO " +
                "WHERE TO_CHAR(EMP_ID) LIKE ? " +
                "OR UPPER(FULL_NAME) LIKE ? " +
                "ORDER BY EMP_ID";

            ps = con.prepareStatement(sql);

            String value = "%" + search.toUpperCase() + "%";

            ps.setString(1, value);
            ps.setString(2, value);

            rs = ps.executeQuery();

            while (rs.next()) {

                Employee e = new Employee();

                e.setEmpId(rs.getInt("EMP_ID"));
                e.setFullName(rs.getString("FULL_NAME"));
                e.setDepartment(rs.getString("DEPARTMENT"));
                e.setPosition(rs.getString("POSITION"));
                e.setJoinDate(rs.getDate("JOIN_DATE"));
                e.setSalary(rs.getDouble("SALARY"));
                e.setPerfScore(rs.getDouble("PERF_SCORE"));
                e.setOfficeLoc(rs.getString("OFFICE_LOC"));

                list.add(e);
            }

        } finally {
            if (rs != null) rs.close();
            if (ps != null) ps.close();
            if (con != null) con.close();
        }

        return list;
    }

    public int getTotalEmployees() throws Exception {

        Connection con = null;
        Statement st = null;
        ResultSet rs = null;

        try {
            con = DBConnection.getConnection();
            st = con.createStatement();

            rs = st.executeQuery(
                "SELECT COUNT(*) FROM INFO"
            );

            if (rs.next()) {
                return rs.getInt(1);
            }

        } finally {
            if (rs != null) rs.close();
            if (st != null) st.close();
            if (con != null) con.close();
        }

        return 0;
    }

    public Employee getEmployeeById(int id) throws Exception {

        Connection con = null;
        PreparedStatement ps = null;
        ResultSet rs = null;

        try {
            con = DBConnection.getConnection();

            ps = con.prepareStatement(
                "SELECT * FROM INFO WHERE EMP_ID = ?"
            );

            ps.setInt(1, id);

            rs = ps.executeQuery();

            if (rs.next()) {

                Employee e = new Employee();

                e.setEmpId(rs.getInt("EMP_ID"));
                e.setFullName(rs.getString("FULL_NAME"));
                e.setDepartment(rs.getString("DEPARTMENT"));
                e.setPosition(rs.getString("POSITION"));
                e.setJoinDate(rs.getDate("JOIN_DATE"));
                e.setSalary(rs.getDouble("SALARY"));
                e.setPerfScore(rs.getDouble("PERF_SCORE"));
                e.setOfficeLoc(rs.getString("OFFICE_LOC"));

                return e;
            }

        } finally {
            if (rs != null) rs.close();
            if (ps != null) ps.close();
            if (con != null) con.close();
        }

        return null;
    }

    public void insertEmployee(Employee e) throws Exception {

        Connection con = null;
        PreparedStatement ps = null;

        try {
            con = DBConnection.getConnection();

            String sql =
                "INSERT INTO INFO " +
                "(EMP_ID, FULL_NAME, DEPARTMENT, POSITION, " +
                "JOIN_DATE, SALARY, PERF_SCORE, OFFICE_LOC) " +
                "VALUES (?, ?, ?, ?, ?, ?, ?, ?)";

            ps = con.prepareStatement(sql);

            ps.setInt(1, e.getEmpId());
            ps.setString(2, e.getFullName());
            ps.setString(3, e.getDepartment());
            ps.setString(4, e.getPosition());
            ps.setDate(5, e.getJoinDate());
            ps.setDouble(6, e.getSalary());
            ps.setDouble(7, e.getPerfScore());
            ps.setString(8, e.getOfficeLoc());

            ps.executeUpdate();

        } finally {
            if (ps != null) ps.close();
            if (con != null) con.close();
        }
    }

    public void updateEmployee(Employee e) throws Exception {

        Connection con = null;
        PreparedStatement ps = null;

        try {
            con = DBConnection.getConnection();

            String sql =
                "UPDATE INFO SET FULL_NAME=?, DEPARTMENT=?, " +
                "POSITION=?, JOIN_DATE=?, SALARY=?, " +
                "PERF_SCORE=?, OFFICE_LOC=? WHERE EMP_ID=?";

            ps = con.prepareStatement(sql);

            ps.setString(1, e.getFullName());
            ps.setString(2, e.getDepartment());
            ps.setString(3, e.getPosition());
            ps.setDate(4, e.getJoinDate());
            ps.setDouble(5, e.getSalary());
            ps.setDouble(6, e.getPerfScore());
            ps.setString(7, e.getOfficeLoc());
            ps.setInt(8, e.getEmpId());

            ps.executeUpdate();

        } finally {
            if (ps != null) ps.close();
            if (con != null) con.close();
        }
    }

    public void deleteEmployee(int id) throws Exception {

        Connection con = null;
        PreparedStatement ps = null;

        try {
            con = DBConnection.getConnection();

            ps = con.prepareStatement(
                "DELETE FROM INFO WHERE EMP_ID=?"
            );

            ps.setInt(1, id);

            ps.executeUpdate();

        } finally {
            if (ps != null) ps.close();
            if (con != null) con.close();
        }
    }
}

