    display: block;
    margin: 15px 0 7px;
    font-weight: bold;
    font-size: 14px;
}

.form-container input {
    width: 100%;
    padding: 11px;
    border: 1px solid #ddd;
    border-radius: 6px;
}

.form-container button {
    margin-top: 22px;
}

.cancel-btn {
    display: inline-block;
    margin-left: 10px;
    color: #555;
    text-decoration: none;
}

@media(max-width:1000px) {
    .cards {
        grid-template-columns: repeat(2,1fr);
    }
}

@media(max-width:650px) {
    .container {
        display: block;
    }

    .sidebar {
        width: 100%;
    }

    .sidebar ul {
        display: flex;
        flex-wrap: wrap;
    }

